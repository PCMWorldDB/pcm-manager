# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-this-in-production-12345678

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123xyz


# Main Database (shared: users, roles, namespaces)
POSTGRES_DB=main
POSTGRES_USER=db_service_account
POSTGRES_PASSWORD=changeme123xyz

# Redis
REDIS_URL=redis://localhost:6379/0

# Cycling API
CYCLING_API_KEY=your-api-key-here
CYCLING_API_URL=https://api.example.com

# Storage (local development paths)
STORAGE_ROOT=./filestore

# Security
BCRYPT_LOG_ROUNDS=12
